# Production Environment Variables
# IMPORTANT: DO NOT COMMIT THIS FILE TO GIT!
# Add .env.production to .gitignore

# Database
POSTGRES_DB=bossbot_production
POSTGRES_USER=bossbot_user
POSTGRES_PASSWORD=CHANGE_ME  # Generate: openssl rand -base64 32

# JWT (MUST be at least 256 bits / 32 characters)
JWT_SECRET=CHANGE_ME  # Generate: openssl rand -base64 48
JWT_EXPIRATION_MS=900000

# Google OAuth
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# CORS and Frontend
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com
APP_FRONTEND_URL=https://yourdomain.com

# OpenAI
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME  # Generate: openssl rand -base64 24
GRAFANA_ROOT_URL=https://metrics.yourdomain.com
GRAFANA_DOMAIN=metrics.yourdomain.com
